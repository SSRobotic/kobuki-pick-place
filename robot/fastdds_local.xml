<?xml version="1.0" encoding="UTF-8" ?>
<!-- Everything on one laptop: ROS 2 talks over 127.0.0.1 only (no shared memory, no multicast). On Windows the default
     setup lost /joint_states for MoveIt (31 Oct). Use it in EVERY window (PowerShell):
       $env:FASTRTPS_DEFAULT_PROFILES_FILE = 'D:\ROS2_Windows_Humble\robot\fastdds_local.xml'
     Up to 40 ROS processes. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_lo</transport_id>
      <type>UDPv4</type>
      <maxInitialPeersRange>40</maxInitialPeersRange>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="lo_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_lo</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
